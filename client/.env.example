VITE_API_URL=http://localhost:4000/api

# ── Payment methods (deposit flow, /app/payment) ────────────────────────────
# These are public by design: Vite inlines every VITE_* value into the bundle,
# so put only receive-side handles here — never a key, seed phrase or API
# secret. QR codes are not env values; drop the images in
# client/public/payment/ as usdt-trc20.png, usdt-bep20.png, binance-pay.png.

# USDT (crypto). A network is only offered to users when its address is set,
# so leave one blank to hide that chain.
VITE_USDT_TRC20_ADDRESS=
VITE_USDT_BEP20_ADDRESS=

# Binance Pay. ID is required; NAME is shown so the payer can confirm the
# account, and LINK is an optional app.binance.com deep link.
VITE_BINANCE_PAY_ID=
VITE_BINANCE_PAY_NAME=ASM Coins
VITE_BINANCE_PAY_LINK=

# INR support contacts. WhatsApp is digits only with the country code and no
# "+"; Telegram is the username, with or without the leading "@".
VITE_WHATSAPP_NUMBER=
VITE_TELEGRAM_USERNAME=
