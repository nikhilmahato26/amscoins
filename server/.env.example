PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/asmcoins
JWT_SECRET=change-me
JWT_EXPIRES=7d
TELEGRAM_LINK=https://t.me/asmcoins_support
TDS_PCT=5
FRONTEND_URL=http://localhost:5173

# --- Email (production: Resend) --------------------------------------------
# Preferred: send via Resend's SMTP from an authenticated asmcoins.com address.
# Set RESEND_API_KEY and mail is signed with SPF+DKIM+DMARC (stays out of spam).
# From MUST be on the verified domain (noreply@asmcoins.com), NOT a gmail.com address.
RESEND_API_KEY=re_your_resend_api_key
MAIL_FROM="ASM Coins <noreply@asmcoins.com>"
MAIL_REPLY_TO=support@asmcoins.com
# Serve the logo from your own domain, not raw.githubusercontent.com
LOGO_URL=https://asmcoins.com/asm.png

# --- Email (local dev fallback: generic SMTP, e.g. Gmail app password) ------
# Ignored when RESEND_API_KEY is set.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=your-gmail-app-password

ADMIN_EMAIL=admin@asmcoins.com
ADMIN_PASSWORD=change-me-admin
REDIS_URL=redis://127.0.0.1:6379
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
