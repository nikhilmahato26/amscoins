# Copy to .env.production on the VPS ONLY (chmod 600). Never commit the real
# file — .gitignore already excludes .env.production / .env.*.local.
#
# Var names here MUST match server/src/config/env.js — that file throws on
# boot if MONGO_URI or JWT_SECRET is missing (see the `required` array).

# --- Mongo (root/cluster admin — used only by mongo-express and backups) ---
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=long_random_string

# --- Mongo (app user — created by deploy/mongo/init-mongo.js) ---
MONGO_APP_USER=appuser
MONGO_APP_PASSWORD=another_long_random_string

# --- mongo-express (DB browser, loopback-only, tunnel with ssh -L 8081:...) ---
MONGOEXPRESS_USER=admin
MONGOEXPRESS_PASSWORD=yet_another_long_random_string

# --- Backend (consumed directly by server/src/config/env.js) ---
# NOTE: variable name is MONGO_URI, not DATABASE_URL — and it needs
# ?replicaSet=rs0 because the app relies on multi-document transactions
# (see deploy/mongo/init-mongo.js for why the single-node replica set exists).
MONGO_URI=mongodb://appuser:another_long_random_string@mongo:27017/asmcoins?replicaSet=rs0&authSource=asmcoins
REDIS_URL=redis://redis:6379
JWT_SECRET=long_random_string
JWT_EXPIRES=7d
TELEGRAM_LINK=https://t.me/asmcoins_support
TDS_PCT=5
FRONTEND_URL=https://asmcoins.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=bhaveshsolminde@gmail.com
SMTP_PASS=your-gmail-app-password
MAIL_FROM="ASM Coins <bhaveshsolminde@gmail.com>"
ADMIN_EMAIL=admin@asmcoins.com
ADMIN_PASSWORD=long_random_string
NODE_ENV=production
